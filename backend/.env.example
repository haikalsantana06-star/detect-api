# ============================================
# CAPE - Desk Occupancy Detection API
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# --- Inference Settings ---
# Confidence threshold (0.0 - 1.0). Higher = stricter occupied detection.
THRESHOLD=0.5

# Device for PyTorch inference: "cpu" or "cuda"
DEVICE=cpu

# Path to trained model files (relative to project root)
MODEL_DIR=models

# Path to zones.json configuration
ZONES_PATH=zones.json

# --- CORS Settings ---
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database Settings ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=upitas_mon
DB_USER=
DB_PASSWORD=

# --- Optional: Logging ---
# LOG_LEVEL=INFO
